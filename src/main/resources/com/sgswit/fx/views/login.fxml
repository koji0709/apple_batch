<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane fx:controller="com.sgswit.fx.controller.LoginController"
            maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <TabPane fx:id="tabPane" prefWidth="320">
            <tabs>
                <Tab closable="false" text="用户登录">
                    <VBox alignment="CENTER" prefWidth="310.0" style="-fx-padding: 7; -fx-spacing: 7; -fx-pref-height: 220">
                        <children>
                            <HBox alignment="CENTER" style="-fx-padding: 5; -fx-spacing: 12">
                                <children>
                                    <Label text="登录账号" />
                                    <TextField fx:id="loginUserNameTextField" />
                                </children>
                            </HBox>
                            <HBox alignment="CENTER" style="-fx-padding: 5; -fx-spacing: 12">
                                <children>
                                    <Label text="登录密码" />
                                    <PasswordField fx:id="loginPwdTextField" />
                                </children>
                            </HBox>
                            <HBox alignment="CENTER" style="-fx-padding: 5; -fx-spacing: 12">
                                <children>
                                    <CheckBox fx:id="rememberMeCheckBox" text="记住用户" />
                                    <CheckBox fx:id="autoLoginCheckBox" text="自动登录" />
                                    <Button onAction="#login" prefWidth="53" text="登录" />
                                </children>
                            </HBox>
                            <VBox alignment="CENTER" style="-fx-padding: 5; -fx-spacing: 12; -fx-background-color: #edf3fc;">
                                <children>
                                    <Label text="小蓝鲸拥有版权保护, 非法篡本软件将承担法律责任。" />
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </Tab>
                <Tab closable="false" text="用户注册">
                    <VBox alignment="CENTER" style="-fx-padding: 7; -fx-spacing: 7; -fx-pref-height: 220">
                        <children>
                            <HBox alignment="CENTER" style="-fx-spacing: 12">
                                <children>
                                    <Label text="注册账号" />
                                    <TextField fx:id="registerUserNameTextField" />
                                </children>
                            </HBox>
                            <HBox alignment="CENTER" style="-fx-spacing: 12">
                                <children>
                                    <Label text="注册密码" />
                                    <PasswordField fx:id="registerPwdTextField" />
                                </children>
                            </HBox>
                            <HBox alignment="CENTER" style="-fx-spacing: 12">
                                <children>
                                    <Label text="安全邮箱" />
                                    <TextField fx:id="registerEmailTextField" />
                                </children>
                            </HBox>
                            <HBox alignment="CENTER" style="-fx-spacing: 12">
                                <children>
                                    <Label text="注册卡密" />
                                    <TextField fx:id="registerCardNoTextField" promptText="可空" />
                                </children>
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 39 0 0">
                                <children>
                                    <Button onAction="#register" text="注册用户" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </Tab>
                <Tab closable="false" text="修改密码">
                    <VBox alignment="CENTER" style="-fx-spacing: 7;">
                        <children>
                            <HBox alignment="CENTER" style="-fx-spacing: 12">
                                <children>
                                    <Label text="需修改账号" />
                                    <TextField fx:id="editUserNameTextField" />
                                </children>
                            </HBox>
                            <HBox alignment="CENTER" style="-fx-spacing: 12">
                                <children>
                                    <Label text="邮箱验证码" />
                                    <TextField fx:id="verifyCodeTextField" prefWidth="68" />
                                    <Button onAction="#sendVerifyCode" prefWidth="83" text="发送验证码" />
                                </children>
                            </HBox>
                            <HBox alignment="CENTER" style="-fx-spacing: 12">
                                <children>
                                    <Label text="设置新密码" />
                                    <PasswordField fx:id="newPwdTextField" />
                                </children>
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 39 0 0;">
                                <children>
                                    <Button onAction="#updatePwd" prefWidth="165" text="修改密码" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
